# ---------------------------------------------------------------------------
# BugBot configuration. Copy to .env and fill in. Never commit .env.
# Run `npm run discover` after setting the Jira block to verify every value.
# ---------------------------------------------------------------------------

# --- Jira: connection ---
# Site base URL, no trailing slash.
JIRA_BASE_URL=https://roarington.atlassian.net
# Verified 2026-09-09 via /_edge/tenant_info. `discover` re-checks this.
JIRA_CLOUD_ID=57de5553-0941-4346-821f-c46f7dde06cc
# Service account email + API token (id.atlassian.com -> Security -> API tokens).
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jira: where bugs live ---
# Support project, id 10396. Board 468 is its board.
JIRA_PROJECT_KEY=SUP
JIRA_BOARD_ID=468
# SUP has no `Bug` type; `Finding` (id 10481) is used. Names only - never IDs:
# src/jira/meta.ts resolves every name below to an ID at boot and fails loudly
# if one is missing, so a Jira rename surfaces at startup instead of at runtime.
JIRA_ISSUE_TYPE=Finding

# --- Jira: workflow status names ---
JIRA_STATUS_TRIAGE=Under Triage
JIRA_STATUS_BACKLOG=To Do
JIRA_STATUS_REJECTED=Rejected
JIRA_STATUS_DUPLICATE=Duplicate
JIRA_STATUS_CANNOT_REPRODUCE=Cannot Reproduce

# Try to set the real human as Jira reporter (needs MODIFY_REPORTER permission).
# Falls back to the service account + a description footer when lookup fails.
JIRA_SET_REAL_REPORTER=true

# Long random string; forms part of the Jira webhook URL path (Phase 3).
# Generate with: openssl rand -hex 32
JIRA_WEBHOOK_SECRET=

# --- Slack (optional in Phase 0, required from Phase 1) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Only needed when SLACK_SOCKET_MODE=true (local development convenience).
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE=false

# --- Slack: people and places ---
# Default triager (QA owner).
SLACK_DEFAULT_TRIAGER=U08HVG0H2EL
# #soft-world - announcements and escalations.
SLACK_ANNOUNCE_CHANNEL=C0AU6L9FPME
# #roarington-dev
SLACK_DEV_CHANNEL=C0AT37C7PFY
# Comma-separated channel IDs allowed to run /bug. Empty = allow anywhere.
# Decided (SPEC 9.4): #soft-world + #roarington-dev only. /bug elsewhere gets an
# ephemeral reply pointing the reporter at these channels.
SLACK_BUG_CHANNEL_ALLOWLIST=C0AU6L9FPME,C0AT37C7PFY
# One of: none | here | channel. Controls escalation loudness (SPEC 7).
ESCALATION_MENTION=none

# --- Runtime ---
# Inside Docker/Fly this is the mounted volume. Locally try ./data/bugbot.db
DATABASE_PATH=/data/bugbot.db
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
